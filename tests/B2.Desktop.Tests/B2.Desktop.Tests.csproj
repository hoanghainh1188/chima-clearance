<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    B2.Desktop targets net8.0-windows10.0.19041.0 and needs the MAUI workload, so this net8.0
    test project cannot ProjectReference it (that is also why the a11y suite analyses XAML as
    files). ApiEndpointResolver is deliberately free of MAUI types so it can be linked in and
    unit-tested here, on the ubuntu CI job.
  -->
  <ItemGroup>
    <Compile Include="../../src/B2.Desktop/Services/ApiEndpointResolver.cs" Link="Linked/ApiEndpointResolver.cs" />
    <Compile Include="../../src/B2.Desktop/Services/ApiEndpoint.cs" Link="Linked/ApiEndpoint.cs" />
    <Compile Include="../../src/B2.Desktop/Services/ApiEndpointSource.cs" Link="Linked/ApiEndpointSource.cs" />
    <Compile Include="../../src/B2.Desktop/Services/Api/IAuthTokenStore.cs" Link="Linked/IAuthTokenStore.cs" />
    <Compile Include="../../src/B2.Desktop/Services/Api/AuthTokenStore.cs" Link="Linked/AuthTokenStore.cs" />
    <Compile Include="../../src/B2.Desktop/Services/Api/ApiErrorCode.cs" Link="Linked/ApiErrorCode.cs" />
    <Compile Include="../../src/B2.Desktop/Services/Api/AuthTokenHandler.cs" Link="Linked/AuthTokenHandler.cs" />
    <Compile Include="../../src/B2.Desktop/Services/LedgerDeltaPolicy.cs" Link="Linked/LedgerDeltaPolicy.cs" />
    <Compile Include="../../src/B2.Desktop/Services/ConnectivityMode.cs" Link="Linked/ConnectivityMode.cs" />
    <Compile Include="../../src/B2.Desktop/Services/ConnectivityPolicy.cs" Link="Linked/ConnectivityPolicy.cs" />
    <Compile Include="../../src/B2.Desktop/Services/Users/UserStatusFilter.cs" Link="Linked/UserStatusFilter.cs" />
    <Compile Include="../../src/B2.Desktop/Services/Users/UserListFilter.cs" Link="Linked/UserListFilter.cs" />
    <Compile Include="../../src/B2.Desktop/Services/Users/TemporaryPassword.cs" Link="Linked/TemporaryPassword.cs" />
    <Compile Include="../../src/B2.Desktop/ViewModels/Admin/UserRow.cs" Link="Linked/UserRow.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\B2.Shared.Contracts\B2.Shared.Contracts.csproj" />
  </ItemGroup>

</Project>
