<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone probe. NOT part of B2.sln / B2.NoMaui.slnf — it must never affect the
       product build. It uses the SAME Microsoft.AspNetCore.SignalR.Client library the
       MAUI desktop uses, so a PASS here means the Go hub is protocol-compatible with the
       unchanged desktop client. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>B2.Spike.SignalRProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
  </ItemGroup>

</Project>
