<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only: uses X509Store (LocalMachine\Root), sc.exe, netsh, DPAPI. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <!-- Required: WindowsPackageType=None so dotnet publish doesn't try to produce an
         MSIX when targeting net8.0-windows*. Same pattern as B2.Desktop. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Produces B2Clearance.exe — the standalone offline installer CLI invoked by
         deploy/install.ps1 (xcopy deployment; no update framework). -->
    <AssemblyName>B2Clearance</AssemblyName>
    <!-- UAC: installer must run as Administrator (installs cert + service). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI for sealing the backup install-password + recovery code at install time. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- F-01: compile the pure-BCL generator + rules from B2.Application directly (linked, not a
         project reference) so the installer stays standalone and uses the exact tested code. -->
    <Compile Include="..\B2.Application\Common\InitialPasswordGenerator.cs" Link="Shared\InitialPasswordGenerator.cs" />
    <Compile Include="..\B2.Application\Common\PasswordRules.cs" Link="Shared\PasswordRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- F-13 / T-S5-05: ship the Sổ B2 export template so the installer lays it down
         at C:\ProgramData\B2\templates\. At runtime the export also embeds this template
         in B2.Infrastructure, so the on-disk copy is an optional override. -->
    <Content Include="Templates\Mẫu sổ B2.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
