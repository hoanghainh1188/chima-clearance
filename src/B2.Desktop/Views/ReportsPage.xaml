<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="B2.Desktop.Views.ReportsPage"
             x:Name="ReportsRoot"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:B2.Desktop.ViewModels"
             xmlns:s="clr-namespace:B2.Desktop.Resources.Strings"
             xmlns:r="clr-namespace:B2.Shared.Contracts.Reports;assembly=B2.Shared.Contracts"
             x:DataType="vm:ReportsViewModel"
             BackgroundColor="{StaticResource ColorSurface}">
  <Grid Padding="{StaticResource SpacingM}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="{StaticResource SpacingS}">
    <Label Grid.Row="0"
           Text="{x:Static s:AppResources.Reports_Title}"
           FontSize="{StaticResource FontSizeXL}"
           TextColor="{StaticResource ColorPrimary}" />

    <Grid Grid.Row="1"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnSpacing="{StaticResource SpacingS}"
          RowDefinitions="Auto,Auto"
          RowSpacing="2">
      <Label Grid.Row="0" Grid.Column="0"
             Text="{x:Static s:AppResources.Reports_Filter_From}"
             TextColor="{StaticResource ColorOnSurfaceMuted}" />
      <DatePicker Grid.Row="1" Grid.Column="0" Date="{Binding FromDate}" />
      <Label Grid.Row="0" Grid.Column="1"
             Text="{x:Static s:AppResources.Reports_Filter_To}"
             TextColor="{StaticResource ColorOnSurfaceMuted}" />
      <DatePicker Grid.Row="1" Grid.Column="1" Date="{Binding ToDate}" />
      <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding IncludeCancelled}" VerticalOptions="Center"
                SemanticProperties.Hint="{x:Static s:AppResources.Reports_IncludeCancelled}" />
      <Label Grid.Row="1" Grid.Column="3"
             Text="{x:Static s:AppResources.Reports_IncludeCancelled}"
             VerticalOptions="Center"
             TextColor="{StaticResource ColorOnSurface}" />
      <Button Grid.Row="1" Grid.Column="5"
              Text="{x:Static s:AppResources.Reports_Action_Refresh}"
              Command="{Binding LoadCommand}" />
      <Button Grid.Row="1" Grid.Column="6"
              Text="{x:Static s:AppResources.Reports_Action_Copy}"
              Command="{Binding CopyCommand}" />
      <Button Grid.Row="1" Grid.Column="7"
              Text="{x:Static s:AppResources.Reports_Action_Export}"
              Command="{Binding ExportExcelCommand}" />
    </Grid>

    <Label Grid.Row="2"
           Text="{Binding ErrorMessage}"
           TextColor="{StaticResource ColorError}"
           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

    <!-- #194: the report tables are short aggregates rendered with BindableLayout; a
         CollectionView inside this ScrollView loses virtualisation and can loop on measure. -->
    <ScrollView Grid.Row="3">
      <VerticalStackLayout Spacing="{StaticResource SpacingM}">

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        <Label Text="{x:Static s:AppResources.Reports_Empty}"
               IsVisible="{Binding HasNoData}"
               TextColor="{StaticResource ColorOnSurfaceMuted}" />

        <!-- Theo người làm thủ tục -->
        <VerticalStackLayout Spacing="2"
                             IsVisible="{Binding Processors.Count, Converter={StaticResource GreaterThanZeroConverter}}">
          <Label Text="{x:Static s:AppResources.Reports_ByProcessor_Title}"
                 FontAttributes="Bold"
                 FontSize="{StaticResource FontSizeL}"
                 TextColor="{StaticResource ColorPrimary}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingS}">
            <Button Grid.Column="0"
                    Text="{x:Static s:AppResources.Reports_Column_Processor}"
                    HorizontalOptions="Start"
                    Command="{Binding SortProcessorCommand}"
                    CommandParameter="name" />
            <Button Grid.Column="1"
                    Text="{x:Static s:AppResources.Reports_Column_TotalVehicles}"
                    Command="{Binding SortProcessorCommand}"
                    CommandParameter="total" />
          </Grid>
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Processors}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="r:ProcessorReportItemDto">
                <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                  <Label Grid.Column="0" Text="{Binding ProcessorName}" />
                  <Label Grid.Column="1" Text="{Binding TotalVehicles}" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Theo bãi -->
        <VerticalStackLayout Spacing="2"
                             IsVisible="{Binding Yards.Count, Converter={StaticResource GreaterThanZeroConverter}}">
          <Label Text="{x:Static s:AppResources.Reports_ByYard_Title}"
                 FontAttributes="Bold"
                 FontSize="{StaticResource FontSizeL}"
                 TextColor="{StaticResource ColorPrimary}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingS}">
            <Button Grid.Column="0"
                    Text="{x:Static s:AppResources.Reports_Column_Yard}"
                    HorizontalOptions="Start"
                    Command="{Binding SortYardCommand}"
                    CommandParameter="name" />
            <Button Grid.Column="1"
                    Text="{x:Static s:AppResources.Reports_Column_TotalVehicles}"
                    Command="{Binding SortYardCommand}"
                    CommandParameter="total" />
          </Grid>
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Yards}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="r:YardReportItemDto">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingS}" Padding="0,2">
                  <Label Grid.Column="0" Text="{Binding YardCode}" FontAttributes="Bold" />
                  <Label Grid.Column="1" Text="{Binding YardName}" />
                  <Label Grid.Column="2" Text="{Binding TotalVehicles}" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Theo giờ xuất -->
        <VerticalStackLayout Spacing="2"
                             IsVisible="{Binding Hours.Count, Converter={StaticResource GreaterThanZeroConverter}}">
          <Label Text="{x:Static s:AppResources.Reports_ByHour_Title}"
                 FontAttributes="Bold"
                 FontSize="{StaticResource FontSizeL}"
                 TextColor="{StaticResource ColorPrimary}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingS}">
            <Button Grid.Column="0"
                    Text="{x:Static s:AppResources.Reports_Column_HourBucket}"
                    HorizontalOptions="Start"
                    Command="{Binding SortHourCommand}"
                    CommandParameter="bucket" />
            <Button Grid.Column="1"
                    Text="{x:Static s:AppResources.Reports_Column_ExitedCount}"
                    Command="{Binding SortHourCommand}"
                    CommandParameter="count" />
          </Grid>
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Hours}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="r:HourReportItemDto">
                <Grid ColumnDefinitions="*,Auto" Padding="0,2">
                  <Label Grid.Column="0" Text="{Binding BucketLabel}" />
                  <Label Grid.Column="1" Text="{Binding ExitedCount}" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Theo cán bộ -->
        <VerticalStackLayout Spacing="2"
                             IsVisible="{Binding Officers.Count, Converter={StaticResource GreaterThanZeroConverter}}">
          <Label Text="{x:Static s:AppResources.Reports_ByOfficer_Title}"
                 FontAttributes="Bold"
                 FontSize="{StaticResource FontSizeL}"
                 TextColor="{StaticResource ColorPrimary}" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
            <Button Grid.Column="0"
                    Text="{x:Static s:AppResources.Reports_Column_Officer}"
                    HorizontalOptions="Start"
                    Command="{Binding SortOfficerCommand}"
                    CommandParameter="name" />
            <Button Grid.Column="1"
                    Text="{x:Static s:AppResources.Reports_Column_VehiclesEntered}"
                    Command="{Binding SortOfficerCommand}"
                    CommandParameter="entered" />
            <Button Grid.Column="2"
                    Text="{x:Static s:AppResources.Reports_Column_KvgsConfirmed}"
                    Command="{Binding SortOfficerCommand}"
                    CommandParameter="kvgs" />
          </Grid>
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Officers}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="r:OfficerReportItemDto">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}" Padding="0,2">
                  <Label Grid.Column="0" Text="{Binding OfficerName}" />
                  <Label Grid.Column="1" Text="{Binding VehiclesEntered}" />
                  <Label Grid.Column="2" Text="{Binding DeclarationsKvgsConfirmed}" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Xe còn trong cổng -->
        <VerticalStackLayout Spacing="2"
                             IsVisible="{Binding Pending.Count, Converter={StaticResource GreaterThanZeroConverter}}">
          <Label Text="{x:Static s:AppResources.Reports_Pending_Title}"
                 FontAttributes="Bold"
                 FontSize="{StaticResource FontSizeL}"
                 TextColor="{StaticResource ColorPrimary}" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
            <Button Grid.Column="0"
                    Text="{x:Static s:AppResources.Reports_Column_DeclarationNo}"
                    HorizontalOptions="Start"
                    Command="{Binding SortPendingCommand}"
                    CommandParameter="decl" />
            <Button Grid.Column="1"
                    Text="{x:Static s:AppResources.Reports_Column_Plate}"
                    Command="{Binding SortPendingCommand}"
                    CommandParameter="plate" />
            <Button Grid.Column="2"
                    Text="{x:Static s:AppResources.Reports_Column_EntryTime}"
                    Command="{Binding SortPendingCommand}"
                    CommandParameter="entry" />
            <Button Grid.Column="3"
                    Text="{x:Static s:AppResources.Reports_Column_HoursInside}"
                    Command="{Binding SortPendingCommand}"
                    CommandParameter="hours" />
          </Grid>
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pending}">
            <BindableLayout.ItemTemplate>
              <DataTemplate x:DataType="r:PendingReportItemDto">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}" Padding="0,2">
                  <Label Grid.Column="0" Text="{Binding DeclarationNumber}" FontAttributes="Bold" />
                  <Label Grid.Column="1" Text="{Binding PlateNumber}" />
                  <Label Grid.Column="2" Text="{Binding EntryTime, StringFormat='{0:yyyy-MM-dd HH:mm}'}" />
                  <Label Grid.Column="3" Text="{Binding HoursInside, StringFormat='{0:0.00}'}" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </VerticalStackLayout>

      </VerticalStackLayout>
    </ScrollView>
  </Grid>
</ContentView>
