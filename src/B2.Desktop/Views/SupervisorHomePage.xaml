<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="B2.Desktop.Views.SupervisorHomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="clr-namespace:B2.Desktop.Resources.Strings"
             Title="{x:Static s:AppResources.Supervisor_HomeTitle}"
             BackgroundColor="{StaticResource ColorSurface}">
  <ScrollView>
    <VerticalStackLayout Padding="{StaticResource SpacingL}" Spacing="{StaticResource SpacingM}">
      <Label Text="{x:Static s:AppResources.Supervisor_HomeTitle}"
             FontSize="{StaticResource FontSizeXL}"
             TextColor="{StaticResource ColorPrimary}" />
      <Label Text="{x:Static s:AppResources.Supervisor_HomeBody}"
             TextColor="{StaticResource ColorOnSurface}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
