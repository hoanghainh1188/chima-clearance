<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="B2.Desktop.Views.ChangePasswordPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:B2.Desktop.ViewModels"
             xmlns:s="clr-namespace:B2.Desktop.Resources.Strings"
             x:DataType="vm:ChangePasswordViewModel"
             Title="{x:Static s:AppResources.ChangePassword_PageTitle}"
             BackgroundColor="{StaticResource ColorSurface}">
  <ScrollView>
    <!-- Same centred card as LoginPage (#196). -->
    <Border Margin="{StaticResource SpacingL}"
            Padding="{StaticResource SpacingL}"
            WidthRequest="{StaticResource LayoutAuthCardWidth}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{StaticResource ColorSurfaceVariant}"
            Stroke="{StaticResource ColorBorder}">
      <VerticalStackLayout Spacing="{StaticResource SpacingM}">
        <Label Text="{x:Static s:AppResources.ChangePassword_PageTitle}"
               FontSize="{StaticResource FontSizeXL}"
               TextColor="{StaticResource ColorPrimary}"
               HorizontalOptions="Center" />
        <Label Text="{x:Static s:AppResources.ChangePassword_Subtitle}"
               HorizontalOptions="Center"
               TextColor="{StaticResource ColorOnSurface}" />
        <Label Text="{x:Static s:AppResources.ChangePassword_CurrentLabel}" />
        <Entry x:Name="CurrentPasswordEntry"
               Text="{Binding CurrentPassword}"
               IsPassword="True"
               SemanticProperties.Hint="{x:Static s:AppResources.ChangePassword_CurrentLabel}" />
        <Label Text="{x:Static s:AppResources.ChangePassword_NewLabel}" />
        <Entry x:Name="NewPasswordEntry"
               Text="{Binding NewPassword}"
               IsPassword="True"
               SemanticProperties.Hint="{x:Static s:AppResources.ChangePassword_NewLabel}" />
        <Label Text="{x:Static s:AppResources.ChangePassword_ConfirmLabel}" />
        <Entry x:Name="ConfirmPasswordEntry"
               Text="{Binding ConfirmPassword}"
               IsPassword="True"
               SemanticProperties.Hint="{x:Static s:AppResources.ChangePassword_ConfirmLabel}" />
        <Label Text="{x:Static s:AppResources.ChangePassword_ComplexityHint}"
               TextColor="{StaticResource ColorOnSurface}" />
        <!-- Wireframe § 9 calls for "polite" live regions on error/info.
             .NET MAUI 8 has no IsLiveSetting equivalent on Label; the bound
             SemanticProperties.Description gives screen readers the message. -->
        <Label Text="{Binding ErrorMessage}"
               TextColor="{StaticResource ColorError}"
               SemanticProperties.Description="{Binding ErrorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
        <Label Text="{Binding InfoMessage}"
               TextColor="{StaticResource ColorPrimary}"
               SemanticProperties.Description="{Binding InfoMessage}"
               IsVisible="{Binding InfoMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
        <Button x:Name="ChangePasswordSubmitButton"
                Text="{x:Static s:AppResources.ChangePassword_Submit}"
                Command="{Binding SubmitCommand}"
                BackgroundColor="{StaticResource ColorPrimary}"
                TextColor="{StaticResource ColorPrimaryOnDark}"
                SemanticProperties.Hint="{x:Static s:AppResources.ChangePassword_Submit}" />
        <Button x:Name="ChangePasswordCancelButton"
                Text="{x:Static s:AppResources.Common_Cancel}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding CanCancel}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource ColorOnSurface}"
                SemanticProperties.Hint="{x:Static s:AppResources.Common_Cancel}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      </VerticalStackLayout>
    </Border>
  </ScrollView>
</ContentPage>
