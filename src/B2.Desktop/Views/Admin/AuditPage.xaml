<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="B2.Desktop.Views.Admin.AuditPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:B2.Desktop.ViewModels"
             xmlns:s="clr-namespace:B2.Desktop.Resources.Strings"
             xmlns:a="clr-namespace:B2.Shared.Contracts.Admin;assembly=B2.Shared.Contracts"
             x:DataType="vm:AuditViewModel"
             BackgroundColor="{StaticResource ColorSurface}">
  <Grid Padding="{StaticResource SpacingM}"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        RowSpacing="{StaticResource SpacingS}">

    <Label Grid.Row="0"
           Text="{x:Static s:AppResources.Audit_Title}"
           FontSize="{StaticResource FontSizeXL}"
           TextColor="{StaticResource ColorPrimary}" />

    <Grid Grid.Row="1"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto"
          ColumnSpacing="{StaticResource SpacingS}"
          RowDefinitions="Auto,Auto"
          RowSpacing="2">
      <Label Grid.Row="0" Grid.Column="0"
             Text="{x:Static s:AppResources.Audit_Filter_EntityType}"
             TextColor="{StaticResource ColorOnSurfaceMuted}" />
      <Picker Grid.Row="1" Grid.Column="0"
              WidthRequest="140"
              ItemsSource="{Binding EntityTypeOptions}"
              SelectedIndex="{Binding EntityTypeIndex}"
              SemanticProperties.Hint="{x:Static s:AppResources.Audit_Filter_EntityType}" />
      <Label Grid.Row="0" Grid.Column="1"
             Text="{x:Static s:AppResources.Audit_Filter_Action}"
             TextColor="{StaticResource ColorOnSurfaceMuted}" />
      <Picker Grid.Row="1" Grid.Column="1"
              WidthRequest="160"
              ItemsSource="{Binding ActionOptions}"
              SelectedIndex="{Binding ActionIndex}"
              SemanticProperties.Hint="{x:Static s:AppResources.Audit_Filter_Action}" />
      <Label Grid.Row="0" Grid.Column="2"
             Text="{x:Static s:AppResources.Audit_Filter_From}"
             TextColor="{StaticResource ColorOnSurfaceMuted}" />
      <DatePicker Grid.Row="1" Grid.Column="2" Date="{Binding FromDate}" />
      <Label Grid.Row="0" Grid.Column="3"
             Text="{x:Static s:AppResources.Audit_Filter_To}"
             TextColor="{StaticResource ColorOnSurfaceMuted}" />
      <DatePicker Grid.Row="1" Grid.Column="3" Date="{Binding ToDate}" />
      <Button Grid.Row="1" Grid.Column="4"
              Text="{x:Static s:AppResources.Audit_Filter_Apply}"
              Command="{Binding ApplyFiltersCommand}" />
    </Grid>

    <Label Grid.Row="2"
           Text="{Binding ErrorMessage}"
           TextColor="{StaticResource ColorError}"
           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingM}">
      <VerticalStackLayout Grid.Column="0" Spacing="2">
        <Grid ColumnDefinitions="120,100,110,110,*" ColumnSpacing="{StaticResource SpacingS}">
          <Label Grid.Column="0" Text="{x:Static s:AppResources.Audit_Column_Time}" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="1" Text="{x:Static s:AppResources.Audit_Column_Actor}" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="2" Text="{x:Static s:AppResources.Audit_Column_Action}" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="3" Text="{x:Static s:AppResources.Audit_Column_EntityType}" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="4" Text="{x:Static s:AppResources.Audit_Column_Entity}" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurfaceMuted}" />
        </Grid>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        <Label Text="{x:Static s:AppResources.Audit_Empty}"
               IsVisible="{Binding HasNoData}"
               TextColor="{StaticResource ColorOnSurfaceMuted}" />

        <CollectionView ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedItem}">
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="a:AuditLogItemDto">
              <Grid ColumnDefinitions="120,100,110,110,*" ColumnSpacing="{StaticResource SpacingS}" Padding="0,2">
                <Label Grid.Column="0" Text="{Binding At, StringFormat='{0:dd/MM HH:mm:ss}'}" />
                <Label Grid.Column="1" Text="{Binding ActorUsername}" />
                <Label Grid.Column="2" Text="{Binding Action}" />
                <Label Grid.Column="3" Text="{Binding EntityType}" />
                <Label Grid.Column="4" Text="{Binding EntityId}" LineBreakMode="TailTruncation" />
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
      </VerticalStackLayout>

      <!-- Before/after detail (wireframe § 6.12 "▸") -->
      <Border Grid.Column="1"
              WidthRequest="320"
              Stroke="{StaticResource ColorBorder}"
              StrokeThickness="1"
              Padding="{StaticResource SpacingS}"
              IsVisible="{Binding HasDetail}">
        <VerticalStackLayout Spacing="{StaticResource SpacingS}">
          <Label Text="{x:Static s:AppResources.Audit_Detail_Title}"
                 FontAttributes="Bold"
                 TextColor="{StaticResource ColorPrimary}" />
          <Label Text="{Binding SelectedItem.Reason}"
                 TextColor="{StaticResource ColorOnSurfaceMuted}"
                 IsVisible="{Binding SelectedItem.Reason, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
          <ScrollView MaximumHeightRequest="420">
            <Label Text="{Binding SelectedItem.ChangesJson}"
                   FontFamily="Consolas"
                   FontSize="{StaticResource FontSizeS}"
                   TextColor="{StaticResource ColorOnSurface}" />
          </ScrollView>
        </VerticalStackLayout>
      </Border>
    </Grid>

    <HorizontalStackLayout Grid.Row="4" Spacing="{StaticResource SpacingS}">
      <Button Text="{x:Static s:AppResources.Audit_PrevPage}" Command="{Binding PrevPageCommand}" />
      <Button Text="{x:Static s:AppResources.Audit_NextPage}" Command="{Binding NextPageCommand}" />
      <Label Text="{Binding PageSummary}"
             VerticalOptions="Center"
             TextColor="{StaticResource ColorOnSurfaceMuted}" />
    </HorizontalStackLayout>
  </Grid>
</ContentView>
