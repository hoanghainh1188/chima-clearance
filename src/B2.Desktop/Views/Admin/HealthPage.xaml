<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="B2.Desktop.Views.Admin.HealthPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:B2.Desktop.ViewModels"
             xmlns:s="clr-namespace:B2.Desktop.Resources.Strings"
             xmlns:a="clr-namespace:B2.Shared.Contracts.Admin;assembly=B2.Shared.Contracts"
             x:DataType="vm:HealthViewModel"
             BackgroundColor="{StaticResource ColorSurface}">
  <Grid Padding="{StaticResource SpacingM}"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="{StaticResource SpacingS}">

    <Label Grid.Row="0"
           Text="{x:Static s:AppResources.Health_Title}"
           FontSize="{StaticResource FontSizeXL}"
           TextColor="{StaticResource ColorPrimary}" />

    <!-- Tabs -->
    <HorizontalStackLayout Grid.Row="1" Spacing="{StaticResource SpacingS}">
      <Button Text="{x:Static s:AppResources.Health_Tab_Overview}" Command="{Binding ShowOverviewCommand}" />
      <Button Text="{x:Static s:AppResources.Health_Tab_Logs}" Command="{Binding ShowLogsCommand}" />
    </HorizontalStackLayout>

    <Label Grid.Row="2"
           Text="{Binding ErrorMessage}"
           TextColor="{StaticResource ColorError}"
           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

    <!-- Overview tab -->
    <ScrollView Grid.Row="3" IsVisible="{Binding IsOverview}">
      <VerticalStackLayout Spacing="{StaticResource SpacingS}">
        <Button Text="{x:Static s:AppResources.Health_Refresh}"
                Command="{Binding LoadHealthCommand}"
                HorizontalOptions="Start" />
        <Border Stroke="{StaticResource ColorBorder}" StrokeThickness="1" Padding="{StaticResource SpacingM}" MaximumWidthRequest="560" HorizontalOptions="Start">
          <Grid ColumnDefinitions="200,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="{StaticResource SpacingM}">
            <Label Grid.Row="0" Grid.Column="0" Text="{x:Static s:AppResources.Health_Row_Uptime}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding UptimeText}" TextColor="{StaticResource ColorOnSurface}" />
            <Label Grid.Row="0" Grid.Column="2" Text="{x:Static s:AppResources.Health_Status_Ok}" />

            <Label Grid.Row="1" Grid.Column="0" Text="{x:Static s:AppResources.Health_Row_Memory}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding MemoryText}" TextColor="{StaticResource ColorOnSurface}" />
            <Label Grid.Row="1" Grid.Column="2" Text="{x:Static s:AppResources.Health_Status_Ok}" />

            <Label Grid.Row="2" Grid.Column="0" Text="{x:Static s:AppResources.Health_Row_DbSize}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding DbSizeText}" TextColor="{StaticResource ColorOnSurface}" />
            <Label Grid.Row="2" Grid.Column="2" Text="{x:Static s:AppResources.Health_Status_Ok}" />

            <Label Grid.Row="3" Grid.Column="0" Text="{x:Static s:AppResources.Health_Row_FreeDisk}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding FreeDiskText}" TextColor="{StaticResource ColorOnSurface}" />
            <Label Grid.Row="3" Grid.Column="2" Text="{Binding DiskStatus}" />

            <Label Grid.Row="4" Grid.Column="0" Text="{x:Static s:AppResources.Health_Row_OpenOld}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
            <Label Grid.Row="4" Grid.Column="1" Text="{Binding OpenOldText}" TextColor="{StaticResource ColorOnSurface}" />
            <Label Grid.Row="4" Grid.Column="2" Text="{Binding OpenOldStatus}" />
          </Grid>
        </Border>
      </VerticalStackLayout>
    </ScrollView>

    <!-- Logs tab -->
    <Grid Grid.Row="3" IsVisible="{Binding IsLogs}" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource SpacingS}">
      <HorizontalStackLayout Grid.Row="0" Spacing="{StaticResource SpacingS}">
        <Label Text="{x:Static s:AppResources.Health_Logs_Level}" VerticalOptions="Center" TextColor="{StaticResource ColorOnSurfaceMuted}" />
        <Picker WidthRequest="160" ItemsSource="{Binding LevelOptions}" SelectedIndex="{Binding LevelIndex}"
                SemanticProperties.Hint="{x:Static s:AppResources.Health_Logs_Level}" />
        <Button Text="{x:Static s:AppResources.Audit_Filter_Apply}" Command="{Binding ApplyLogFilterCommand}" />
      </HorizontalStackLayout>

      <VerticalStackLayout Grid.Row="1" Spacing="2">
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        <Label Text="{x:Static s:AppResources.Health_Logs_Empty}"
               IsVisible="{Binding HasNoLogs}"
               TextColor="{StaticResource ColorOnSurfaceMuted}" />
        <CollectionView ItemsSource="{Binding Logs}" SelectionMode="None">
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="a:LogEntryDto">
              <Grid ColumnDefinitions="150,90,*" ColumnSpacing="{StaticResource SpacingS}" Padding="0,2">
                <Label Grid.Column="0" Text="{Binding At, StringFormat='{0:dd/MM HH:mm:ss}'}" FontSize="{StaticResource FontSizeS}" />
                <Label Grid.Column="1" Text="{Binding Level}" FontSize="{StaticResource FontSizeS}" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="{Binding Message}" LineBreakMode="TailTruncation" FontSize="{StaticResource FontSizeS}" />
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
      </VerticalStackLayout>

      <HorizontalStackLayout Grid.Row="2" Spacing="{StaticResource SpacingS}">
        <Button Text="{x:Static s:AppResources.Audit_PrevPage}" Command="{Binding PrevPageCommand}" />
        <Button Text="{x:Static s:AppResources.Audit_NextPage}" Command="{Binding NextPageCommand}" />
        <Label Text="{Binding PageSummary}" VerticalOptions="Center" TextColor="{StaticResource ColorOnSurfaceMuted}" />
      </HorizontalStackLayout>
    </Grid>
  </Grid>
</ContentView>
