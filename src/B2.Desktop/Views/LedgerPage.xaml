<?xml version="1.0" encoding="UTF-8" ?>
<ContentView x:Class="B2.Desktop.Views.LedgerPage"
             x:Name="LedgerRoot"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:B2.Desktop.ViewModels"
             xmlns:s="clr-namespace:B2.Desktop.Resources.Strings"
             xmlns:decl="clr-namespace:B2.Shared.Contracts.Declarations;assembly=B2.Shared.Contracts"
             xmlns:system="clr-namespace:System;assembly=netstandard"
             xmlns:common="clr-namespace:B2.Desktop.Views.Common"
             x:DataType="vm:LedgerViewModel"
             BackgroundColor="{StaticResource ColorSurface}">
  <!-- Single cell: the detail drawer overlays the right edge (HorizontalOptions=End)
       rather than sitting in an Auto column. A Border inside an Auto-width column
       renders its content blank on WinUI; the overlay measures deterministically. -->
  <Grid>
    <Grid
          Padding="{StaticResource SpacingM}"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="{StaticResource SpacingS}">
    <Border Grid.Row="0"
            Padding="{StaticResource SpacingS}"
            BackgroundColor="{StaticResource ColorErrorBg}"
            IsVisible="{Binding ShowOfflineBanner}">
      <Label Text="{x:Static s:AppResources.Connectivity_OfflineBanner}"
             TextColor="{StaticResource ColorError}" />
    </Border>
    <Border Grid.Row="1"
            Padding="{StaticResource SpacingS}"
            BackgroundColor="{StaticResource ColorWarningBanner}"
            IsVisible="{Binding ShowPollingBanner}">
      <Label Text="{x:Static s:AppResources.Connectivity_PollingBanner}"
             TextColor="{StaticResource ColorWarning}" />
    </Border>
    <HorizontalStackLayout Grid.Row="2" Spacing="{StaticResource SpacingS}">
      <Label Text="{x:Static s:AppResources.Ledger_ConnectivityPrefix}"
             TextColor="{StaticResource ColorOnSurfaceMuted}" />
      <Label Text="{Binding ConnectivityLabel}"
             FontAttributes="Bold"
             TextColor="{StaticResource ColorOnSurface}" />
    </HorizontalStackLayout>
    <Grid Grid.Row="3"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
          RowSpacing="{StaticResource SpacingS}">
      <common:SkeletonRows Grid.Row="0"
                           IsVisible="{Binding IsLoading}" />
      <VerticalStackLayout Grid.Row="1"
                           Spacing="{StaticResource SpacingS}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}">
        <Label Text="{Binding ErrorMessage}"
               TextColor="{StaticResource ColorError}" />
        <common:ErrorCodeBanner BindingContext="{Binding Correlation}" />
        <Button Text="{x:Static s:AppResources.Common_Retry}"
                Command="{Binding RefreshCommand}" />
      </VerticalStackLayout>
      <Label Grid.Row="2"
             Text="{Binding LedgerSubtitle}"
             FontSize="{StaticResource FontSizeXL}"
             TextColor="{StaticResource ColorPrimary}"
             IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
      <VerticalStackLayout Grid.Row="3"
                           Spacing="{StaticResource SpacingS}"
                           IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
        <Label Text="{x:Static s:AppResources.Ledger_Search_Label}"
               TextColor="{StaticResource ColorOnSurfaceMuted}" />
        <Grid ColumnDefinitions="360,Auto"
              ColumnSpacing="{StaticResource SpacingS}"
              HorizontalOptions="Start">
          <Entry x:Name="PlateSearchEntry"
                 Grid.Column="0"
                 Text="{Binding PlateSearch}"
                 ReturnType="Search"
                 ReturnCommand="{Binding SearchFromFilterCommand}"
                 SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Search_Label}" />
          <Button Grid.Column="1"
                  Text="{x:Static s:AppResources.Ledger_Search_Button}"
                  Command="{Binding SearchFromFilterCommand}" />
        </Grid>
        <HorizontalStackLayout Spacing="{StaticResource SpacingM}">
          <CheckBox IsChecked="{Binding FilterOnlyUnexited}"
                    VerticalOptions="Center"
                    SemanticProperties.Hint="{x:Static s:AppResources.Ledger_UnexitedOnly}" />
          <Label Text="{x:Static s:AppResources.Ledger_UnexitedOnly}"
                 VerticalOptions="Center"
                 TextColor="{StaticResource ColorOnSurface}" />
        </HorizontalStackLayout>
      </VerticalStackLayout>
      <Grid Grid.Row="4"
            ColumnDefinitions="*,*,*,Auto"
            ColumnSpacing="{StaticResource SpacingS}"
            RowDefinitions="Auto,Auto"
            RowSpacing="{StaticResource SpacingS}"
            IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
        <Label Grid.Row="0"
               Grid.Column="0"
               Text="{x:Static s:AppResources.Ledger_Filter_DateLabel}"
               TextColor="{StaticResource ColorOnSurfaceMuted}" />
        <Picker Grid.Row="1"
                Grid.Column="0"
                ItemsSource="{Binding DatePresetOptions}"
                SelectedIndex="{Binding DatePresetIndex}"
                SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Filter_DateLabel}" />
        <Label Grid.Row="0"
               Grid.Column="1"
               Text="{x:Static s:AppResources.Ledger_Filter_StatusLabel}"
               TextColor="{StaticResource ColorOnSurfaceMuted}" />
        <Picker Grid.Row="1"
                Grid.Column="1"
                ItemsSource="{Binding StatusFilterOptions}"
                SelectedIndex="{Binding StatusFilterIndex}"
                SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Filter_StatusLabel}" />
        <Label Grid.Row="0"
               Grid.Column="2"
               Text="{x:Static s:AppResources.Ledger_Filter_YardLabel}"
               TextColor="{StaticResource ColorOnSurfaceMuted}" />
        <Picker Grid.Row="1"
                Grid.Column="2"
                ItemsSource="{Binding YardPickerSource}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedYard}"
                SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Filter_YardLabel}" />
        <Button Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="3"
                Text="{x:Static s:AppResources.Ledger_ResetFilters}"
                Command="{Binding ResetFiltersCommand}"
                VerticalOptions="Center" />
      </Grid>
      <Grid Grid.Row="5"
            RowDefinitions="Auto,*"
            IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
        <!-- Sticky column header (wireframe § 6.2). Same column template as the
             data rows below so the titles line up. -->
        <Grid Grid.Row="0"
              IsVisible="{Binding ShowDataGrid}"
              Padding="{StaticResource SpacingS}"
              BackgroundColor="{StaticResource ColorLedgerDailyHeaderBg}"
              ColumnDefinitions="32,100,*,*,*,*,*,64"
              ColumnSpacing="6">
          <Label Grid.Column="0" Text="{x:Static s:AppResources.Ledger_Col_No}" FontAttributes="Bold" FontSize="{StaticResource FontSizeS}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="1" Text="{x:Static s:AppResources.Ledger_Col_Status}" FontAttributes="Bold" FontSize="{StaticResource FontSizeS}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="2" Text="{x:Static s:AppResources.Ledger_Col_Declaration}" FontAttributes="Bold" FontSize="{StaticResource FontSizeS}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="3" Text="{x:Static s:AppResources.Ledger_Col_Company}" FontAttributes="Bold" FontSize="{StaticResource FontSizeS}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="4" Text="{x:Static s:AppResources.Ledger_Col_Processor}" FontAttributes="Bold" FontSize="{StaticResource FontSizeS}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="5" Text="{x:Static s:AppResources.Ledger_Col_Vehicle}" FontAttributes="Bold" FontSize="{StaticResource FontSizeS}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="6" Text="{x:Static s:AppResources.Ledger_Col_Yard}" FontAttributes="Bold" FontSize="{StaticResource FontSizeS}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Grid.Column="7" Text="{x:Static s:AppResources.Ledger_Col_Time}" FontAttributes="Bold" FontSize="{StaticResource FontSizeS}" TextColor="{StaticResource ColorOnSurfaceMuted}" />
        </Grid>
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding DisplayItems}"
                        IsVisible="{Binding ShowDataGrid}"
                        SelectionMode="None">
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:LedgerUiItem">
              <Grid Padding="0,2">
                <Border IsVisible="{Binding IsDateHeader}"
                        Padding="{StaticResource SpacingS}"
                        BackgroundColor="{StaticResource ColorLedgerDailyHeaderBg}">
                  <Grid ColumnDefinitions="*,220,Auto,Auto" ColumnSpacing="{StaticResource SpacingS}">
                    <Label Grid.Column="0"
                           Text="{Binding HeaderText}"
                           TextColor="{StaticResource ColorOnSurface}"
                           LineBreakMode="WordWrap" />
                    <Entry Grid.Column="1"
                           Text="{Binding OfficerName}"
                           Placeholder="{x:Static s:AppResources.Ledger_Header_OfficerPlaceholder}"
                           SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Header_OfficerPlaceholder}" />
                    <Button Grid.Column="2"
                            Text="{x:Static s:AppResources.Common_Save}"
                            Command="{Binding Source={x:Reference LedgerRoot}, Path=BindingContext.SaveOfficerNameCommand}"
                            CommandParameter="{Binding .}" />
                    <Button Grid.Column="3"
                            Text="{x:Static s:AppResources.Ledger_Recompute_Action}"
                            IsVisible="{Binding Source={x:Reference LedgerRoot}, Path=BindingContext.IsAdmin}"
                            Command="{Binding Source={x:Reference LedgerRoot}, Path=BindingContext.RecomputeDailySummaryCommand}"
                            CommandParameter="{Binding .}" />
                  </Grid>
                </Border>
                <Grid IsVisible="{Binding IsDataRow}"
                      Padding="{StaticResource SpacingS}"
                      ColumnDefinitions="32,100,*,*,*,*,*,64"
                      ColumnSpacing="6">
                  <Grid.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="2"
                                          Command="{Binding Source={x:Reference LedgerRoot}, Path=BindingContext.OpenDetailCommand}"
                                          CommandParameter="{Binding Row}" />
                  </Grid.GestureRecognizers>
                  <Label Grid.Column="0"
                         Text="{Binding Row.RowOrdinal}"
                         VerticalOptions="Center"
                         WidthRequest="28"
                         TextColor="{StaticResource ColorOnSurfaceMuted}" />
                  <HorizontalStackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                    <Label Text="{Binding Row.StatusIcon}" />
                    <Label Text="{Binding Row.StatusLabel}"
                           SemanticProperties.Description="{Binding Row.StatusLabel}">
                      <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Row.Dto.Status}"
                                     Value="Open">
                          <Setter Property="TextColor" Value="{StaticResource ColorLedgerStatusOpen}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Row.Dto.Status}"
                                     Value="AllExited">
                          <Setter Property="TextColor" Value="{StaticResource ColorLedgerStatusAllExited}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Row.Dto.Status}"
                                     Value="KVGSConfirmed">
                          <Setter Property="TextColor" Value="{StaticResource ColorLedgerStatusKvgsConfirmed}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Row.Dto.Status}"
                                     Value="Cancelled">
                          <Setter Property="TextColor" Value="{StaticResource ColorLedgerStatusCancelled}" />
                        </DataTrigger>
                      </Label.Triggers>
                    </Label>
                  </HorizontalStackLayout>
                  <Label Grid.Column="2"
                         Text="{Binding Row.DeclarationMasked}"
                         FontAttributes="Bold"
                         VerticalOptions="Center"
                         LineBreakMode="TailTruncation">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding Row.IsCancelled}" Value="True">
                        <Setter Property="TextDecorations" Value="Strikethrough" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                  <Label Grid.Column="3"
                         Text="{Binding Row.CompanyName}"
                         VerticalOptions="Center"
                         LineBreakMode="TailTruncation"
                         TextColor="{StaticResource ColorOnSurface}">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding Row.IsCancelled}" Value="True">
                        <Setter Property="TextDecorations" Value="Strikethrough" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                  <Label Grid.Column="4"
                         Text="{Binding Row.ProcessorName}"
                         VerticalOptions="Center"
                         LineBreakMode="TailTruncation"
                         TextColor="{StaticResource ColorOnSurfaceMuted}"
                         FontSize="{StaticResource FontSizeS}" />
                  <Label Grid.Column="5"
                         Text="{Binding Row.PlateAndTrailerLine}"
                         VerticalOptions="Center"
                         LineBreakMode="TailTruncation"
                         TextColor="{StaticResource ColorOnSurface}">
                    <Label.Triggers>
                      <DataTrigger TargetType="Label" Binding="{Binding Row.IsCancelled}" Value="True">
                        <Setter Property="TextDecorations" Value="Strikethrough" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>
                  <Label Grid.Column="6"
                         Text="{Binding Row.YardLabel}"
                         VerticalOptions="Center"
                         TextColor="{StaticResource ColorOnSurfaceMuted}"
                         FontSize="{StaticResource FontSizeS}" />
                  <Label Grid.Column="7"
                         Text="{Binding Row.TimeLocal}"
                         VerticalOptions="Center"
                         TextColor="{StaticResource ColorOnSurface}" />
                </Grid>
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Grid.Row="1"
               Text="{x:Static s:AppResources.Ledger_Empty}"
               IsVisible="{Binding ShowEmpty}"
               TextColor="{StaticResource ColorOnSurfaceMuted}"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
      </Grid>
      <HorizontalStackLayout Grid.Row="6"
                             Spacing="{StaticResource SpacingM}"
                             HorizontalOptions="Center"
                             VerticalOptions="End"
                             IsVisible="{Binding ShowDataGrid}">
        <Label Text="{Binding DisplayRangeText}"
               VerticalOptions="Center"
               TextColor="{StaticResource ColorOnSurfaceMuted}" />
        <Button Text="{x:Static s:AppResources.Ledger_PrevPage}"
                Command="{Binding PrevPageCommand}" />
        <Label Text="{Binding PageSummary}"
               VerticalOptions="Center" />
        <Button Text="{x:Static s:AppResources.Ledger_NextPage}"
                Command="{Binding NextPageCommand}" />
      </HorizontalStackLayout>
    </Grid>
    </Grid>
    <Grid HorizontalOptions="End"
          IsVisible="{Binding IsDrawerOpen}"
          WidthRequest="420"
          BackgroundColor="{StaticResource ColorSidebarBg}"
          Padding="{StaticResource SpacingM}">
      <!-- A CollectionView nested in the drawer rendered the whole panel blank
           on WinUI (infinite-height measurement). The vehicle list uses
           BindableLayout (inline, finite height) inside a single ScrollView. -->
      <ScrollView>
        <VerticalStackLayout Spacing="{StaticResource SpacingM}">
          <Grid ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{x:Static s:AppResources.Ledger_Drawer_Title}"
                   FontAttributes="Bold"
                   FontSize="{StaticResource FontSizeXL}"
                   TextColor="{StaticResource ColorPrimary}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="{x:Static s:AppResources.Common_Close}"
                    Command="{Binding CloseDetailCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource ColorOnSurface}" />
          </Grid>
          <ActivityIndicator IsRunning="{Binding IsDrawerLoading}"
                             IsVisible="{Binding IsDrawerLoading}"
                             HorizontalOptions="Center" />
          <Label Text="{Binding DrawerErrorMessage}"
                 TextColor="{StaticResource ColorError}"
                 LineBreakMode="WordWrap"
                 IsVisible="{Binding DrawerErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
          <VerticalStackLayout Spacing="{StaticResource SpacingS}"
                               IsVisible="{Binding HasDrawerData}">
            <!-- Cột C: one row may carry several tờ khai and the cell stays editable while the
                 declaration is Open (business rules cột C, confirmed with the unit 2026-08-01). -->
            <Label Text="{x:Static s:AppResources.Ledger_Drawer_NumbersLabel}"
                   TextColor="{StaticResource ColorOnSurfaceMuted}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DrawerNumbers}"
                                 Spacing="2">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="system:String">
                  <HorizontalStackLayout Spacing="{StaticResource SpacingS}">
                    <Label Text="{Binding .}"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{StaticResource ColorOnSurface}" />
                    <Button Text="{x:Static s:AppResources.Ledger_Drawer_RemoveNumber}"
                            FontSize="{StaticResource FontSizeS}"
                            Padding="8,0"
                            Command="{Binding Source={x:Reference LedgerRoot}, Path=BindingContext.RemoveDeclarationNumberCommand}"
                            CommandParameter="{Binding .}"
                            IsVisible="{Binding Source={x:Reference LedgerRoot}, Path=BindingContext.CanRemoveNumber}"
                            SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Drawer_RemoveNumber}" />
                  </HorizontalStackLayout>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource SpacingS}"
                  IsVisible="{Binding CanEditNumbers}">
              <Entry Grid.Column="0"
                     Text="{Binding NewDeclarationNumber}"
                     MaxLength="12"
                     Keyboard="Numeric"
                     Placeholder="{x:Static s:AppResources.Ledger_Drawer_AddNumberPlaceholder}"
                     SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Drawer_AddNumber}" />
              <Button Grid.Column="1"
                      Text="{x:Static s:AppResources.Ledger_Drawer_AddNumber}"
                      Command="{Binding AddDeclarationNumberCommand}"
                      FontSize="{StaticResource FontSizeS}"
                      SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Drawer_AddNumber}" />
            </Grid>
            <HorizontalStackLayout Spacing="{StaticResource SpacingS}">
              <Label Text="{x:Static s:AppResources.Ledger_Drawer_StatusLabel}"
                     TextColor="{StaticResource ColorOnSurfaceMuted}" />
              <Label Text="{Binding SelectedDeclarationDetail.Declaration.Status, Converter={StaticResource DeclarationStatusToTextConverter}}"
                     FontAttributes="Bold"
                     TextColor="{StaticResource ColorOnSurface}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="{StaticResource SpacingS}">
              <Label Text="{x:Static s:AppResources.Ledger_Drawer_ProcessorLabel}"
                     TextColor="{StaticResource ColorOnSurfaceMuted}" />
              <Label Text="{Binding SelectedDeclarationDetail.Declaration.Processor.FullName}"
                     TextColor="{StaticResource ColorOnSurface}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="{StaticResource SpacingS}">
              <Label Text="{x:Static s:AppResources.Ledger_Drawer_YardLabel}"
                     TextColor="{StaticResource ColorOnSurfaceMuted}" />
              <Label Text="{Binding SelectedDeclarationDetail.Declaration.Yard.Name}"
                     TextColor="{StaticResource ColorOnSurface}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="{StaticResource SpacingS}">
              <Label Text="{x:Static s:AppResources.Ledger_Drawer_CompanyLabel}"
                     TextColor="{StaticResource ColorOnSurfaceMuted}" />
              <Label Text="{Binding SelectedDeclarationDetail.Declaration.CompanyName}"
                     TextColor="{StaticResource ColorOnSurface}"
                     LineBreakMode="WordWrap" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="{StaticResource SpacingS}">
              <Label Text="{x:Static s:AppResources.Ledger_Drawer_GoodsLabel}"
                     TextColor="{StaticResource ColorOnSurfaceMuted}" />
              <Label Text="{Binding SelectedDeclarationDetail.Declaration.GoodsName}"
                     TextColor="{StaticResource ColorOnSurface}"
                     LineBreakMode="WordWrap" />
            </HorizontalStackLayout>
            <Label Text="{x:Static s:AppResources.Ledger_Drawer_Title}"
                   FontAttributes="Bold"
                   FontSize="{StaticResource FontSizeL}"
                   TextColor="{StaticResource ColorPrimary}"
                   Margin="0,8,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DrawerVehicles}"
                                 Spacing="0">
              <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:DrawerVehicleViewModel">
                  <Border Padding="{StaticResource SpacingS}"
                          Stroke="{StaticResource ColorBorder}"
                          StrokeThickness="0,0,0,1">
                    <VerticalStackLayout Spacing="2">
                      <HorizontalStackLayout Spacing="{StaticResource SpacingS}">
                        <Label Text="{Binding PlateNumber}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ColorOnSurface}" />
                        <Label Text="{Binding TrailerOrContainerNumber}"
                               TextColor="{StaticResource ColorOnSurfaceMuted}"
                               IsVisible="{Binding TrailerOrContainerNumber, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
                      </HorizontalStackLayout>
                      <Label TextColor="{StaticResource ColorOnSurfaceMuted}"
                             FontSize="{StaticResource FontSizeS}"
                             Text="{Binding EntryTime}" />
                      <Label TextColor="{StaticResource ColorLedgerStatusOpen}"
                             FontSize="{StaticResource FontSizeS}"
                             FontAttributes="Bold"
                             IsVisible="{Binding ExitMarked, Converter={StaticResource InvertedBoolConverter}}"
                             Text="{x:Static s:AppResources.Ledger_Drawer_VehicleInside}" />
                      <Label TextColor="{StaticResource ColorLedgerStatusAllExited}"
                             FontSize="{StaticResource FontSizeS}"
                             FontAttributes="Bold"
                             IsVisible="{Binding ExitMarked}"
                             Text="{x:Static s:AppResources.Ledger_Drawer_VehicleExited}" />

                      <!-- Ghi chú (cột O): business rules § 3 lets the exit-gate officer fill
                           this, so it is editable here rather than only at entry. -->
                      <Label Text="{x:Static s:AppResources.Ledger_Drawer_NoteLabel}"
                             FontSize="{StaticResource FontSizeS}"
                             TextColor="{StaticResource ColorOnSurfaceMuted}"
                             Margin="0,6,0,0" />
                      <Entry Text="{Binding Note}"
                             Placeholder="{x:Static s:AppResources.Ledger_Drawer_NotePlaceholder}"
                             IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                             SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Drawer_NoteLabel}" />
                      <Button Text="{x:Static s:AppResources.Ledger_Drawer_SaveNote}"
                              Command="{Binding SaveNoteCommand}"
                              IsEnabled="{Binding CanSaveNote}"
                              HorizontalOptions="Start"
                              FontSize="{StaticResource FontSizeS}"
                              SemanticProperties.Hint="{x:Static s:AppResources.Ledger_Drawer_SaveNote}" />
                    </VerticalStackLayout>
                  </Border>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
          </VerticalStackLayout>
        </VerticalStackLayout>
      </ScrollView>
    </Grid>
  </Grid>
</ContentView>
