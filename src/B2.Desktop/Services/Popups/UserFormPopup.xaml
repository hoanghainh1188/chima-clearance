<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup x:Class="B2.Desktop.Services.Popups.UserFormPopup"
               xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:s="clr-namespace:B2.Desktop.Resources.Strings"
               x:Name="PopupRoot"
               CanBeDismissedByTappingOutsideOfPopup="True"
               Color="Transparent">
  <!-- Wireframe § 6.8 "Add/Edit user dialog". Field order = tab order. -->
  <Border Padding="{StaticResource SpacingL}"
          BackgroundColor="{StaticResource ColorSurface}"
          StrokeThickness="1"
          Stroke="{StaticResource ColorBorder}"
          MinimumWidthRequest="480">
    <VerticalStackLayout Spacing="{StaticResource SpacingM}">
      <Grid ColumnDefinitions="*,Auto">
        <Label x:Name="TitleLabel"
               Grid.Column="0"
               VerticalOptions="Center"
               FontAttributes="Bold"
               FontSize="{StaticResource FontSizeXL}"
               TextColor="{StaticResource ColorPrimary}" />
        <Button Grid.Column="1"
                Text="{x:Static s:AppResources.Users_Dialog_CloseGlyph}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource ColorOnSurface}"
                Clicked="OnCancelClicked"
                SemanticProperties.Description="{x:Static s:AppResources.Common_Close}"
                SemanticProperties.Hint="{x:Static s:AppResources.Common_Close}" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto,Auto,Auto"
            ColumnSpacing="{StaticResource SpacingM}"
            RowSpacing="{StaticResource SpacingS}">
        <Label Grid.Row="0" Grid.Column="0"
               Text="{x:Static s:AppResources.Users_Dialog_UsernameLabel}"
               VerticalOptions="Center"
               TextColor="{StaticResource ColorOnSurface}" />
        <Entry x:Name="UsernameEntry"
               Grid.Row="0" Grid.Column="1"
               MaxLength="50"
               IsSpellCheckEnabled="False"
               IsTextPredictionEnabled="False"
               SemanticProperties.Hint="{x:Static s:AppResources.Users_Dialog_UsernameLabel}" />

        <Label Grid.Row="1" Grid.Column="0"
               Text="{x:Static s:AppResources.Users_Dialog_FullNameLabel}"
               VerticalOptions="Center"
               TextColor="{StaticResource ColorOnSurface}" />
        <Entry x:Name="FullNameEntry"
               Grid.Row="1" Grid.Column="1"
               MaxLength="200"
               SemanticProperties.Hint="{x:Static s:AppResources.Users_Dialog_FullNameLabel}" />

        <Label Grid.Row="2" Grid.Column="0"
               Text="{x:Static s:AppResources.Users_Dialog_RoleLabel}"
               VerticalOptions="Center"
               TextColor="{StaticResource ColorOnSurface}" />
        <Picker x:Name="RolePicker"
                Grid.Row="2" Grid.Column="1"
                SemanticProperties.Hint="{x:Static s:AppResources.Users_Dialog_RoleLabel}" />

        <Label x:Name="PasswordLabel"
               Grid.Row="3" Grid.Column="0"
               Text="{x:Static s:AppResources.Users_Dialog_PasswordLabel}"
               VerticalOptions="Start"
               Margin="0,10,0,0"
               TextColor="{StaticResource ColorOnSurface}" />
        <VerticalStackLayout x:Name="PasswordSection"
                             Grid.Row="3" Grid.Column="1"
                             Spacing="{StaticResource SpacingS}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingS}">
            <Entry x:Name="PasswordEntry"
                   Grid.Column="0"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False"
                   SemanticProperties.Hint="{x:Static s:AppResources.Users_Dialog_PasswordLabel}" />
            <Button Grid.Column="1"
                    Text="{x:Static s:AppResources.Users_Dialog_Generate}"
                    Clicked="OnGenerateClicked"
                    SemanticProperties.Hint="{x:Static s:AppResources.Users_Dialog_GenerateHint}" />
          </Grid>
          <Label Text="{x:Static s:AppResources.Users_Dialog_PasswordRules}"
                 FontSize="{StaticResource FontSizeXS}"
                 TextColor="{StaticResource ColorOnSurfaceMuted}" />
          <Label Text="{x:Static s:AppResources.Users_Dialog_MustChangeWarning}"
                 FontSize="{StaticResource FontSizeS}"
                 TextColor="{StaticResource ColorWarning}"
                 LineBreakMode="WordWrap" />
        </VerticalStackLayout>
      </Grid>

      <Label x:Name="ErrorLabel"
             IsVisible="False"
             TextColor="{StaticResource ColorError}"
             LineBreakMode="WordWrap" />

      <HorizontalStackLayout Spacing="{StaticResource SpacingS}"
                             HorizontalOptions="End">
        <Button Text="{x:Static s:AppResources.Common_Cancel}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource ColorOnSurface}"
                Clicked="OnCancelClicked"
                SemanticProperties.Hint="{x:Static s:AppResources.Common_Cancel}" />
        <Button x:Name="SubmitButton"
                BackgroundColor="{StaticResource ColorPrimary}"
                TextColor="{StaticResource ColorSurface}"
                Clicked="OnSubmitClicked" />
      </HorizontalStackLayout>
    </VerticalStackLayout>
  </Border>
</toolkit:Popup>
